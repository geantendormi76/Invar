{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "output": {
    "filePath": "c/repomix-output.xml",
    "style": "xml",
    "compress": false,
    "removeComments": false,
    "showLineNumbers": false,
    "fileSummary": true,
    "directoryStructure": true,
    "files": true,
    "truncateBase64": true,
    "git": {
      "sortByChanges": true,
      "sortByChangesMaxCommits": 50
    }
  },
  "include": [
    "README.md",
    "c/**/*.md",
    "src-tauri/Cargo.toml",
    "src-tauri/crates/**/Cargo.toml",
    "src-tauri/crates/**/src/**/*.rs",
    "src-tauri/crates/**/tests/**/*.rs",
    "src-tauri/python/pyproject.toml",
    "src-tauri/python/src/**/*.py",
    "src-tauri/python/scripts/**/*.py",
    "src-tauri/python/tests/**/*.py",
    "src/**/*.{vue,ts,tsx,js,json}",
    "scripts/**/*.py",
    "tests/**/*"
  ],
  "ignore": {
    "useGitignore": true,
    "useDotIgnore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "c/repomix-output*.xml",
      "c/1_.json",
      "c/**/*.png",
      "c/**/*.jpg",
      "models/**",
      "data/**",
      "tmp/**",
      "**/target/**",
      "**/.venv/**",
      "**/__pycache__/**",
      "**/node_modules/**",
      "**/dist/**",
      "*.lock",
      "**/*.bk"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  }
}
