def load_http_hosts(path: Path | None) -> tuple[set[str], int]:
    if path is None:
        return set(), 0
    hosts: set[str] = set()
    rows = read_jsonl(path)
    for record in rows:
        url = first(record, ["url", "input", "final_url"])
        if isinstance(url, str) and url:
            try:
                host = urlparse(url).hostname
            except ValueError:
                host = None
            if host:
