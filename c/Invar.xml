            "record_index": idx,
            "record_id": record_id,
            "surface_id": surface_id,
            "endpoint_id": str(legacy_id),
            "method": method,
            "path": path,
            "source_file": source_file,
            "source_line": source_line,
            "is_dynamic": bool(first(item, ["is_dynamic"], False)),
            "extracted_params": params,
