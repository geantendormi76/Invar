        assert_eq!(result.task_id, "case-001");
        assert_eq!(result.status, "completed");
        assert_eq!(result.attempts, 2);
        assert_eq!(
            result.decision.as_ref().unwrap().rationale,
            "evidence is sufficient"
        );
    }
}
